NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only rollout gate. Enable only after the directed routing migration and
# multi-account authorization tests pass in an explicitly approved test environment.
ORKESTRA_DIRECT_REQUESTS_ENABLED=false

# Enable only after M1–M3 migrations and isolated multi-account checks pass.
ORKESTRA_PREJOB_CHAT_ENABLED=false

# M4: enable only after migration and isolated participant/concurrency checks.
ORKESTRA_QUOTE_REVISIONS_ENABLED=false

