{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "styles:check": "node scripts/verify-style-entrypoints.mjs",
    "predev": "npm run styles:check",
    "dev": "node scripts/run-vinext.mjs dev",
    "prebuild": "npm run styles:check",
    "build": "node scripts/run-vinext.mjs build",
    "prestart": "npm run styles:check",
    "start": "node scripts/run-vinext.mjs start",
    "lint": "node scripts/run-project-tool.mjs eslint . --ignore-pattern dist --ignore-pattern .next",
    "type-check": "node scripts/run-project-tool.mjs tsc --noEmit",
    "test": "node scripts/run-project-tool.mjs vitest run",
    "test:watch": "node scripts/run-project-tool.mjs vitest",
    "test:coverage": "node scripts/run-project-tool.mjs vitest run --coverage",
    "test:e2e": "node scripts/run-project-tool.mjs playwright test",
    "test:remote:phase65": "node scripts/run-phase65-remote.mjs",
    "quality": "npm run styles:check && npm run lint && npm run type-check && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "2.115.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
